# Start with demo; no paid API is ever called in demo mode.
UGC_MODE=demo
UGC_DATA_DIR=./data
# Required outside loopback. scripts/bootstrap.py creates a random value.
UGC_TOKEN=
UGC_DAILY_BUDGET=25
UGC_MAX_ATTEMPTS=2
UGC_WORKER_CONCURRENCY=1
UGC_AUTO_APPROVE=false
UGC_SECURE_COOKIE=false
# Hosted production needs only FAL_KEY. Do not put keys in the frontend.
FAL_KEY=
UGC_TTS_PROVIDER=fal
# Optional: use the included CPU Kokoro service instead of hosted TTS.
UGC_VOICE_URL=http://voice:8091
UGC_WORKER_TOKEN=
# Optional: included Wan worker (image-to-video B-roll, no lip-sync).
UGC_COMFY_URL=http://comfyui:8188
# Optional: included self-hosted InfiniteTalk API; use 48+ GB GPU to start.
UGC_AVATAR_URL=http://avatar:8092
UGC_AVATAR_TRANSPORT=http
# Optional RunPod Serverless transport for the included avatar worker.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Rates are planning estimates; update from your provider's actual bill.
UGC_GPU_HOURLY=0.75
UGC_LOCAL_HOURLY=0.10
UGC_RENDER_RESOLUTION=720
UGC_SCRIPT_PROVIDER=template
UGC_OLLAMA_URL=http://host.docker.internal:11434
UGC_OLLAMA_MODEL=qwen2.5:3b
